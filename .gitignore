# v0 runtime files (should only exist in preview, not in git)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules/
.next/
.env*.local
.DS_Store
*.tsbuildinfo

# Vercel CLI project linkage — machine-local, and it carries project/org ids.
.vercel

# Generated by Next.js on build; references .next/types, so committing it breaks
# a fresh clone's typecheck before the first build.
next-env.d.ts

# pnpm 10 scaffolds this with a placeholder; a workspace file at the root also
# makes Vercel treat this single app as a monorepo.
pnpm-workspace.yaml
supabase/.temp/
